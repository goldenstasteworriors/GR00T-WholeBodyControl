[Unit]
Description=SONIC onboard D435i RGB camera (ZMQ 5555)
After=network.target

[Service]
Type=simple
User=unitree
WorkingDirectory=/home/unitree/GR00T-WholeBodyControl
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/unitree/GR00T-WholeBodyControl/.venv_camera/bin/python -m gear_sonic.camera.composed_camera --ego-view-camera usb --ego-view-device-id /dev/v4l/by-id/usb-Intel_R__RealSense_TM__Depth_Camera_435i_Intel_R__RealSense_TM__Depth_Camera_435i_254843062005-video-index0 --fps 30 --port 5555 --profile-timing --profile-interval 10
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
