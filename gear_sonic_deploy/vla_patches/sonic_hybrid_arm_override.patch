+      auto decode_fixed_floating_array = [&](int field_idx, auto& output,
+                                             const char* field_name) -> bool {
+        if (field_idx < 0) return false;
+        const auto& field = hdr.fields[field_idx];
+        const auto& buffer = bufs[field_idx];
+        constexpr size_t count = std::tuple_size_v<std::decay_t<decltype(output)>>;
+        const bool is_f32 = field.dtype == "f32";
+        const bool is_f64 = field.dtype == "f64";
+        if (!is_f32 && !is_f64) {
+          std::cerr << "[ZMQManager] " << field_name
+                    << " must use f32 or f64" << std::endl;
+          return false;
+        }
+        const size_t scalar_size = is_f32 ? sizeof(float) : sizeof(double);
+        if (buffer.size < count * scalar_size) {
+          std::cerr << "[ZMQManager] " << field_name << " payload too small: "
+                    << buffer.size << " < " << count * scalar_size << std::endl;
+          return false;
+        }
+        for (size_t i = 0; i < count; ++i) {
+          if (is_f32) {
+            float value;
+            std::memcpy(&value,
+                        static_cast<const uint8_t*>(buffer.data) + i * sizeof(float),
+                        sizeof(float));
+            if (needs_swap) value = byte_swap(value);
+            output[i] = static_cast<double>(value);
+          } else {
+            double value;
+            std::memcpy(&value,
+                        static_cast<const uint8_t*>(buffer.data) + i * sizeof(double),
+                        sizeof(double));
+            if (needs_swap) value = byte_swap(value);
+            output[i] = value;
+          }
+        }
+        return true;
+      };
